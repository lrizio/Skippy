{
  "name": "skippy",
  "productName": "Skippy",
  "version": "1.12.0",
  "description": "Skippy - group video conferencing for up to 10 participants",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.hamprojects.skippy",
    "productName": "Skippy",
    "files": [
      "main.js",
      "preload.js",
      "icon.png",
      "icon.ico",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "artifactName": "Skippy-Setup-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.social-networking",
      "artifactName": "Skippy-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "artifactName": "Skippy-${version}.${ext}"
    },
    "icon": "icon.png",
    "directories": {
      "output": "dist"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Skippy",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "author": "VK3EI",
  "license": "MIT",
  "homepage": "https://github.com/lrizio/Skippy",
  "repository": {
    "type": "git",
    "url": "https://github.com/lrizio/Skippy.git"
  }
}