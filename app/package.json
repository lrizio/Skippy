{
  "name": "skippy",
  "productName": "Skippy",
  "version": "1.18.0",
  "description": "Skippy - group video conferencing for up to 10 participants",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac --universal"
  },
  "build": {
    "appId": "com.hamprojects.skippy",
    "productName": "Skippy",
    "files": [
      "main.js",
      "preload.js",
      "recorder.js",
      "icon.png",
      "icon.ico",
      "renderer/**/*",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "artifactName": "Skippy-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.social-networking",
      "artifactName": "Skippy-${version}-mac.${ext}",
      "icon": "build/icon-mac.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "Skippy uses the camera so the other people in a call can see you.",
        "NSMicrophoneUsageDescription": "Skippy uses the microphone so the other people in a call can hear you.",
        "NSLocalNetworkUsageDescription": "Skippy connects to other call participants and to your Skippy server."
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "artifactName": "Skippy-${version}.${ext}"
    },
    "icon": "icon.png",
    "directories": {
      "output": "dist"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Skippy",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false
    },
    "dmg": {
      "title": "Skippy ${version}"
    }
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "author": "VK3EI",
  "license": "MIT",
  "homepage": "https://github.com/lrizio/Skippy",
  "repository": {
    "type": "git",
    "url": "https://github.com/lrizio/Skippy.git"
  }
}
